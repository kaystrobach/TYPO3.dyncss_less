{
  "name": "kaystrobach/dyncss-less",
  "description": "DynCss-Parser",
  "type": "typo3-cms-extension",
  "require": {
    "typo3/cms-core": "^12.4 || ^13.4 || ^14.0",
    "kaystrobach/dyncss": "*"
  },
  "replace": {
    "kaystrobach/dyncss_less": "self.version",
    "typo3-ter/dyncss_less": "self.version"
  },
  "autoload": {
    "psr-4": {
      "KayStrobach\\DyncssLess\\": "Classes/"
    }
  },
  "keywords": [
    "dyncss",
    "less"
  ],
  "homepage": "http://donate.kay-strobach.de/",
  "extra": {
    "typo3/cms": {
      "cms-package-dir": "{$vendor-dir}/typo3/cms",
      "web-dir": ".Build/Web",
      "extension-key": "dyncss_less",
      "version": "0.7.9",
      "Package": {
        "providesPackages": {}
      }
    }
  }
}
