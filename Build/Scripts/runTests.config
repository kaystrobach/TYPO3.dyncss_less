# Settings of Build/Scripts/runTests.sh for this package
PACKAGE_NAME="kaystrobach/dyncss-less"
TEST_NAMESPACE='KayStrobach\DyncssLess\Tests\'
SUPPORTED_VERSIONS="12 13 14"
CORE_PACKAGES="core backend extbase fluid frontend install"
DATABASE=sqlite

# dyncss: the clone next to this one (e.g. vendor/kaystrobach/dyncss), otherwise its branch on GitHub
DYNCSS_PATH="${DYNCSS_PATH:-$(cd "${EXTENSION_ROOT}/.." && pwd)/dyncss}"
if [ -f "${DYNCSS_PATH}/composer.json" ]; then
    EXTRA_DOCKER_VOLUMES="-v ${DYNCSS_PATH}:/dependencies/dyncss"
    EXTRA_REPOSITORIES=('{"type": "path", "url": "/dependencies/dyncss", "options": {"symlink": true, "versions": {"kaystrobach/dyncss": "99.0.0"}}}')
    EXTRA_REQUIRE=()
else
    EXTRA_REPOSITORIES=('{"type": "vcs", "url": "https://github.com/kaystrobach/TYPO3.dyncss"}')
    EXTRA_REQUIRE=('"kaystrobach/dyncss": "dev-typo3-12-13-14"')
fi

# LESS_PHP=wikimedia Build/Scripts/runTests.sh: with wikimedia/less.php instead of the bundled less.php
if [ "${LESS_PHP:-bundled}" = "wikimedia" ]; then
    EXTRA_REQUIRE+=('"wikimedia/less.php": "^5.5"')
    BUILD_SUFFIX="-wikimedia"
fi
